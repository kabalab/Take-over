PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-in-production

# Local dev: omit both vars to use file:./data/takeover.db (no Turso account needed).
# Production: set libsql://... URL and auth token from Turso dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
